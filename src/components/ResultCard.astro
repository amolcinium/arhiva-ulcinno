---
import { SOURCE_LABELS, SOURCE_COUNTRIES, type ArchiveResult } from '../lib/supabase';
interface Props { rec: ArchiveResult; q?: string }
const { rec, q = '' } = Astro.props;
const sourceLabel = SOURCE_LABELS[rec.source] ?? rec.source;
const country = SOURCE_COUNTRIES[rec.source];
const dateLabel = rec.date_text ?? (rec.date_year_min ? `${rec.date_year_min}${rec.date_year_max && rec.date_year_max !== rec.date_year_min ? `–${rec.date_year_max}` : ''}` : null);
const detailUrl = `/item/${rec.id}${q ? `?q=${encodeURIComponent(q)}` : ''}`;
---
<article class="border border-gold/40 rounded-sm bg-white/40 hover:bg-white/80 hover:border-venetian transition p-5 flex flex-col gap-2 cursor-pointer group" onclick={`window.location='${detailUrl}'`}>
  <div class="flex items-start justify-between gap-3">
    <h3 class="text-lg font-semibold leading-tight">
      <a href={detailUrl} class="group-hover:text-venetian">
        {rec.title}
      </a>
    </h3>
    {rec.thumbnail_url && (
      <img src={rec.thumbnail_url} alt="" loading="lazy" class="w-20 h-20 object-cover rounded-sm border border-gold/30" />
    )}
  </div>
  <div class="flex flex-wrap gap-2 text-xs font-sans">
    <span class="px-2 py-0.5 bg-venetian/10 text-venetian rounded">{sourceLabel}</span>
    {country && <span class="px-2 py-0.5 bg-ink/5 text-ink/70 rounded" title={country.country}>{country.flag} {country.country}</span>}
    {dateLabel && <span class="px-2 py-0.5 bg-ink/10 rounded">{dateLabel}</span>}
    {rec.location && <span class="px-2 py-0.5 bg-ottoman/10 text-ottoman rounded">📍 {rec.location}</span>}
    {rec.doc_type && <span class="px-2 py-0.5 bg-gold/20 rounded">{rec.doc_type}</span>}
    {rec.language && <span class="px-2 py-0.5 bg-ink/10 rounded">{rec.language}</span>}
    {rec.url_iiif && <span class="px-2 py-0.5 bg-ottoman/20 text-ottoman rounded text-[10px]">🔍 IIIF</span>}
  </div>
  {rec.author && <p class="text-sm italic text-ink/70">{rec.author}</p>}
  {rec.snippet && <p class="text-sm text-ink/80 line-clamp-3">{rec.snippet}</p>}
  <div class="flex flex-wrap gap-3 text-xs font-sans pt-1 items-center" onclick="event.stopPropagation()">
    <a href={detailUrl} class="text-venetian hover:underline font-medium">📖 Detalji →</a>
    <button
      type="button"
      class="compare-btn text-ink/60 hover:text-venetian"
      data-id={rec.id}
      data-title={rec.title.slice(0, 80)}
      title="Dodaj u uporedjivanje (max 4)"
    >⚖️ Uporedi</button>
    <button
      type="button"
      class="hide-btn hidden ml-auto text-ink/50 hover:text-venetian"
      data-id={rec.id}
      title="Sakrij ovaj rezultat (samo admin)"
    >🗑 Sakrij</button>
  </div>
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('.compare-btn').forEach(btn => {
        if (btn.dataset.bound) return;
        btn.dataset.bound = '1';
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          e.preventDefault();
          const id = btn.dataset.id, title = btn.dataset.title;
          const added = window.arhivaCompare.add(id, title);
          btn.textContent = added ? '✓ Dodato' : (window.arhivaCompare.get().some(x => x.id === id) ? '✓ Već u listi' : '⚠ Lista puna (max 4)');
          setTimeout(() => { btn.textContent = '⚖️ Uporedi'; }, 2000);
        });
      });
    });
  </script>
</article>
