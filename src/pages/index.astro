---
import Layout from '../layouts/Layout.astro';
import { LOCATIONS, SOURCE_LABELS, searchResults } from '../lib/supabase';
import ResultCard from '../components/ResultCard.astro';

const url = new URL(Astro.request.url);
const q = url.searchParams.get('q') ?? '';
const location = url.searchParams.get('location') ?? '';
const source = url.searchParams.get('source') ?? '';
const page = parseInt(url.searchParams.get('p') ?? '1', 10);
const limit = 30;
const offset = (page - 1) * limit;

let results: any[] = [];
let total = 0;
let error: string | null = null;

if (q || location || source) {
  try {
    const r = await searchResults({ q, location, source, limit, offset });
    results = r.results;
    total = r.total;
  } catch (e: any) {
    error = e.message ?? 'Greška u pretrazi';
  }
}

const totalPages = Math.ceil(total / limit);
---
<Layout title="Arhiva Ulcinj — pretraga starih izvora">
  <section class="border-b border-gold/40 bg-gradient-to-b from-parchment to-parchment/50">
    <div class="max-w-4xl mx-auto px-4 py-12 text-center">
      <h1 class="text-4xl md:text-5xl font-semibold mb-3">Arhiva Ulcinj</h1>
      <p class="text-lg text-ink/70 mb-8 max-w-2xl mx-auto">
        Pretraga starih dokumenata, mletačkih karata, rimskih natpisa i digitalnih arhiva o Ulcinju, Bojani, Svaču, Bar-u i okolini.
      </p>
      <form method="get" class="flex flex-col sm:flex-row gap-2 max-w-3xl mx-auto">
        <input
          type="search"
          name="q"
          value={q}
          placeholder="npr. Olcinium, Dulcigno, gusari, Bojana..."
          class="flex-1 px-4 py-3 border-2 border-gold/40 bg-white rounded-sm focus:border-venetian focus:outline-none font-serif text-lg"
        />
        <button type="submit" class="px-6 py-3 bg-venetian text-parchment font-sans font-medium rounded-sm hover:bg-venetian/90 transition">
          Traži
        </button>
      </form>

      <div class="mt-6 flex flex-wrap gap-2 justify-center text-sm font-sans">
        <span class="text-ink/60 mr-2">Brzi linkovi:</span>
        {LOCATIONS.slice(0, 8).map((loc) => (
          <a href={`/?location=${loc.key}`} class={`px-3 py-1 rounded-sm border ${location === loc.key ? 'bg-venetian text-parchment border-venetian' : 'bg-white/60 border-gold/40 hover:bg-white'}`}>
            {loc.label.split(' / ')[0]}
          </a>
        ))}
      </div>
    </div>
  </section>

  {(q || location || source) && (
    <section class="max-w-6xl mx-auto px-4 py-8">
      <div class="flex items-center justify-between mb-6 gap-4">
        <div>
          <h2 class="text-2xl font-semibold">
            {total} rezultata
            {q && <> za "<em class="text-venetian">{q}</em>"</>}
            {location && <span class="text-ink/60 text-base"> · lokacija: {LOCATIONS.find(l => l.key === location)?.label ?? location}</span>}
          </h2>
        </div>
        <details class="font-sans text-sm">
          <summary class="cursor-pointer hover:text-venetian">Filteri</summary>
          <form method="get" class="mt-3 p-4 bg-white/60 border border-gold/40 rounded-sm flex flex-col gap-3 min-w-[280px]">
            <input type="hidden" name="q" value={q} />
            <label class="flex flex-col gap-1">
              <span>Lokacija</span>
              <select name="location" class="px-2 py-1 border border-gold/40 bg-white rounded-sm">
                <option value="">— sve —</option>
                {LOCATIONS.map((l) => <option value={l.key} selected={location === l.key}>{l.label}</option>)}
              </select>
            </label>
            <label class="flex flex-col gap-1">
              <span>Izvor</span>
              <select name="source" class="px-2 py-1 border border-gold/40 bg-white rounded-sm">
                <option value="">— svi —</option>
                {Object.entries(SOURCE_LABELS).map(([k, v]) => <option value={k} selected={source === k}>{v}</option>)}
              </select>
            </label>
            <button type="submit" class="px-4 py-2 bg-venetian text-parchment rounded-sm">Primijeni</button>
          </form>
        </details>
      </div>

      {error && <p class="text-venetian">⚠️ {error} — provjeri da li je Supabase migracija primijenjena.</p>}

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {results.map((rec) => <ResultCard rec={rec} q={q} />)}
      </div>

      {results.length === 0 && !error && (
        <p class="text-center text-ink/60 py-16 font-sans">
          Nema rezultata. Pokušaj drugu varijantu imena (npr. "Dulcigno" umjesto "Ulcinj") ili pretraži direktno preko skill-a:<br/>
          <code class="bg-white/60 px-2 py-1 rounded">cd ~/.claude/skills/archive-search && python3 search.py "{q}"</code>
        </p>
      )}

      {totalPages > 1 && (
        <nav class="mt-8 flex justify-center gap-2 font-sans text-sm">
          {Array.from({ length: Math.min(totalPages, 10) }, (_, i) => i + 1).map((p) => {
            const params = new URLSearchParams({ q, location, source, p: String(p) });
            return (
              <a href={`/?${params.toString()}`} class={`px-3 py-1 rounded-sm border ${p === page ? 'bg-venetian text-parchment border-venetian' : 'bg-white/60 border-gold/40 hover:bg-white'}`}>{p}</a>
            );
          })}
        </nav>
      )}
    </section>
  )}

  {!q && !location && !source && (
    <section class="max-w-5xl mx-auto px-4 py-12">
      <h2 class="text-2xl font-semibold text-center mb-2">Šta sve pretražuješ jednom komandom</h2>
      <p class="text-center text-ink/60 mb-8 font-sans text-sm">Klikni karticu da otvoriš sve rezultate iz tog izvora</p>
      <div class="grid md:grid-cols-3 gap-6 font-sans">
        <a href="/?source=europeana" class="group p-6 border border-gold/40 rounded-sm bg-white/40 hover:bg-white/80 hover:border-venetian transition shadow-sm hover:shadow-md">
          <h3 class="text-lg font-semibold mb-2 font-serif group-hover:text-venetian">📜 Mletačke karte →</h3>
          <p class="text-sm text-ink/70">Camocio (1571), Coronelli (1688), gravire i atlasi sa Ulcinjem, Skadrom, Bojanom. Izvor: Europeana.</p>
        </a>
        <a href="/?source=edh" class="group p-6 border border-gold/40 rounded-sm bg-white/40 hover:bg-white/80 hover:border-venetian transition shadow-sm hover:shadow-md">
          <h3 class="text-lg font-semibold mb-2 font-serif group-hover:text-venetian">🏛 Rimski natpisi →</h3>
          <p class="text-sm text-ink/70">EDH (Heidelberg) — 212 antičkih find-spotova u Ulcinj-Skadar regionu: Olcinium, Scodra, Doclea, Lissus, Acruvium.</p>
        </a>
        <a href="/?source=internet_archive" class="group p-6 border border-gold/40 rounded-sm bg-white/40 hover:bg-white/80 hover:border-venetian transition shadow-sm hover:shadow-md">
          <h3 class="text-lg font-semibold mb-2 font-serif group-hover:text-venetian">📚 Stare knjige →</h3>
          <p class="text-sm text-ink/70">Internet Archive: Šufflay, Jireček, Marković, Jovićević, novije monografije.</p>
        </a>
        <a href="/?source=pelagios" class="group p-6 border border-gold/40 rounded-sm bg-white/40 hover:bg-white/80 hover:border-venetian transition shadow-sm hover:shadow-md">
          <h3 class="text-lg font-semibold mb-2 font-serif group-hover:text-venetian">🌍 Antičke lokacije →</h3>
          <p class="text-sm text-ink/70">Pelagios Pleiades — linked-data za antičke gradove i pomorske rute Jadrana.</p>
        </a>
        <a href="/?source=wikidata" class="group p-6 border border-gold/40 rounded-sm bg-white/40 hover:bg-white/80 hover:border-venetian transition shadow-sm hover:shadow-md">
          <h3 class="text-lg font-semibold mb-2 font-serif group-hover:text-venetian">🔗 Wikidata →</h3>
          <p class="text-sm text-ink/70">SPARQL upiti za istorijska mjesta, osobe, događaje sa multi-jezičnim labelima.</p>
        </a>
        <a href="/mapa" class="group p-6 border border-gold/40 rounded-sm bg-white/40 hover:bg-white/80 hover:border-venetian transition shadow-sm hover:shadow-md">
          <h3 class="text-lg font-semibold mb-2 font-serif group-hover:text-venetian">🗺 Interaktivna mapa →</h3>
          <p class="text-sm text-ink/70">200+ EDH find-spotova na Leaflet mapi. Klik na marker za listu natpisa sa te lokacije.</p>
        </a>
      </div>
    </section>
  )}
</Layout>
