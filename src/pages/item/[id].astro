---
import Layout from '../../layouts/Layout.astro';
import { getItem, getRelated, SOURCE_LABELS, SOURCE_COUNTRIES, LOCATIONS } from '../../lib/supabase';
import { toBibtex, toApa, toChicago } from '../../lib/citation';

const { id } = Astro.params;
const url = new URL(Astro.request.url);
const q = url.searchParams.get('q') ?? '';

if (!id) {
  return Astro.redirect('/');
}

const item = await getItem(id);
if (!item) {
  return new Response('Not found', { status: 404 });
}
const related = await getRelated(item, 6);
const sourceLabel = SOURCE_LABELS[item.source] ?? item.source;
const locationLabel = LOCATIONS.find(l => l.key === item.location)?.label ?? item.location ?? '';
const dateLabel = item.date_text ?? (item.date_year_min ? `${item.date_year_min}${item.date_year_max && item.date_year_max !== item.date_year_min ? `–${item.date_year_max}` : ''}` : null);

// Highlight helper: wraps query terms in <mark>
function highlight(text: string | null | undefined, terms: string[]): string {
  if (!text) return '';
  let out = text;
  // Sort by length desc so longer matches replace first
  const sorted = [...new Set(terms.filter(t => t.length >= 3))].sort((a, b) => b.length - a.length);
  for (const term of sorted) {
    const escaped = term.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    out = out.replace(new RegExp(`(${escaped})`, 'gi'), '<mark class="bg-gold/40 px-0.5 rounded">$1</mark>');
  }
  return out;
}

// Build query terms: the search query + location variants
const queryTerms = q ? q.split(/\s+/).filter(t => t.length >= 3) : [];
if (item.location) queryTerms.push(item.location);

const highlightedTitle = highlight(item.title, queryTerms);
const highlightedSnippet = highlight(item.snippet, queryTerms);
const highlightedFullText = highlight(item.full_text, queryTerms);

const hasIiif = !!item.url_iiif;
const miradorUrl = hasIiif ? `https://projectmirador.org/embed/?iiif-content=${encodeURIComponent(item.url_iiif!)}` : '';

const citeBibtex = toBibtex(item);
const citeApa = toApa(item);
const citeChicago = toChicago(item);
---
<Layout title={`${item.title.slice(0, 80)} — Arhiva Ulcinj`} description={item.snippet ?? `${item.title} · izvor: ${sourceLabel}`}>
  <article class="max-w-5xl mx-auto px-4 py-8">

    <nav class="text-sm font-sans mb-4 text-ink/60">
      <a href="/" class="hover:text-venetian">← Pretraga</a>
      {q && <> · <a href={`/?q=${encodeURIComponent(q)}`} class="hover:text-venetian">"{q}"</a></>}
      {item.location && <> · <a href={`/?location=${item.location}`} class="hover:text-venetian">{locationLabel}</a></>}
      <> · <span>{sourceLabel}</span></>
    </nav>

    <header class="mb-6 pb-6 border-b-2 border-gold/40">
      <div class="flex flex-wrap gap-2 mb-3 text-xs font-sans">
        <span class="px-2 py-0.5 bg-venetian/10 text-venetian rounded font-medium">{sourceLabel}</span>
        {SOURCE_COUNTRIES[item.source] && (
          <span class="px-2 py-0.5 bg-ink/5 text-ink/70 rounded" title={SOURCE_COUNTRIES[item.source].country}>
            {SOURCE_COUNTRIES[item.source].flag} {SOURCE_COUNTRIES[item.source].country}
          </span>
        )}
        {dateLabel && <span class="px-2 py-0.5 bg-ink/10 rounded">{dateLabel}</span>}
        {locationLabel && <span class="px-2 py-0.5 bg-ottoman/10 text-ottoman rounded">📍 {locationLabel}</span>}
        {item.doc_type && <span class="px-2 py-0.5 bg-gold/20 rounded">{item.doc_type}</span>}
        {item.language && <span class="px-2 py-0.5 bg-ink/10 rounded">{item.language}</span>}
      </div>
      <h1 class="text-3xl md:text-4xl font-semibold leading-tight" set:html={highlightedTitle}></h1>
      {item.author && <p class="mt-2 text-lg italic text-ink/70" set:html={highlight(item.author, queryTerms)}></p>}
    </header>

    <div class="grid md:grid-cols-3 gap-8">

      <div class="md:col-span-2 space-y-6">
        {item.thumbnail_url && (
          <img src={item.thumbnail_url} alt={item.title} loading="lazy"
               class="max-w-full md:max-w-md border-2 border-gold/40 rounded-sm shadow-md" />
        )}

        {item.snippet && (
          <section>
            <h2 class="font-sans text-sm uppercase tracking-wider text-ink/60 mb-2">Opis</h2>
            <p class="text-lg leading-relaxed" set:html={highlightedSnippet}></p>
          </section>
        )}

        {item.full_text && (
          <section id="transcript" data-item-id={item.id}>
            <div class="flex items-center justify-between mb-3">
              <h2 class="font-sans text-sm uppercase tracking-wider text-ink/60">Full transcript dokumenta</h2>
              {(item.metadata as any)?.transcript_cg ? (
                <button id="toggle-cg-btn" type="button"
                        class="text-xs font-sans px-3 py-1 bg-venetian text-parchment rounded-sm hover:bg-venetian/90">
                  🇲🇪 Prikaži CG prevod
                </button>
              ) : (
                <button id="translate-cg-btn" type="button"
                        class="text-xs font-sans px-3 py-1 border border-gold/40 bg-white/60 rounded-sm hover:bg-white/90 hover:border-venetian">
                  📜 Prevedi na CG
                </button>
              )}
            </div>
            <details class="mb-4">
              <summary class="cursor-pointer text-sm font-sans text-ink/60 hover:text-venetian mb-2">
                Tekst je {item.full_text.length} karaktera. Klikni da otvoriš/zatvoriš.
              </summary>
              <div id="transcript-original" class="bg-white/40 p-4 border border-gold/40 rounded-sm max-h-[600px] overflow-y-auto">
                <pre class="text-sm font-mono whitespace-pre-wrap leading-relaxed" set:html={highlightedFullText}></pre>
              </div>
            </details>
            {(item.metadata as any)?.transcript_cg && (
              <div id="transcript-cg" class="hidden bg-parchment/60 p-4 border border-venetian/40 rounded-sm max-h-[600px] overflow-y-auto">
                <p class="text-xs font-sans uppercase tracking-wider text-venetian mb-2">Prevod na crnogorski (Claude AI)</p>
                <div class="text-base leading-relaxed" set:html={highlight((item.metadata as any).transcript_cg, queryTerms)}></div>
              </div>
            )}
            <div id="translate-status" class="hidden mt-3 p-3 bg-gold/10 border border-gold/40 rounded-sm font-sans text-sm"></div>
          </section>
        )}

        {hasIiif && (
          <section>
            <h2 class="font-sans text-sm uppercase tracking-wider text-ink/60 mb-2">IIIF Viewer</h2>
            <div class="aspect-video border-2 border-gold/40 rounded-sm overflow-hidden bg-ink/5">
              <iframe
                src={miradorUrl}
                title={`Mirador viewer for ${item.title}`}
                class="w-full h-full"
                allowfullscreen
                loading="lazy"
              ></iframe>
            </div>
            <p class="text-xs font-sans text-ink/60 mt-2">
              Mirador omogućava zoom, listanje strana, i side-by-side poređenje sa drugim IIIF dokumentima.
              <a href={miradorUrl} target="_blank" rel="noopener" class="text-venetian hover:underline ml-2">Otvori full-screen ↗</a>
            </p>
          </section>
        )}

        <!-- Citation export -->
        <section class="pt-4 border-t border-gold/40" id="cite-section">
          <h2 class="font-sans text-sm uppercase tracking-wider text-ink/60 mb-3">Citiraj</h2>
          <div class="flex flex-wrap gap-2 mb-3" id="cite-buttons">
            <button data-fmt="bibtex" class="cite-btn px-3 py-1 border border-gold/40 bg-white/60 rounded-sm text-sm font-sans hover:bg-white/90 hover:border-venetian transition">
              BibTeX
            </button>
            <button data-fmt="apa" class="cite-btn px-3 py-1 border border-gold/40 bg-white/60 rounded-sm text-sm font-sans hover:bg-white/90 hover:border-venetian transition">
              APA
            </button>
            <button data-fmt="chicago" class="cite-btn px-3 py-1 border border-gold/40 bg-white/60 rounded-sm text-sm font-sans hover:bg-white/90 hover:border-venetian transition">
              Chicago
            </button>
          </div>
          <div id="cite-output" class="hidden">
            <pre id="cite-pre" class="bg-white/60 border border-gold/40 rounded-sm p-3 text-xs font-mono whitespace-pre-wrap leading-relaxed overflow-x-auto"></pre>
            <button id="cite-copy-btn" class="mt-2 text-xs font-sans px-3 py-1 border border-gold/40 bg-white/60 rounded-sm hover:bg-white/90 hover:border-venetian transition">
              Kopiraj
            </button>
          </div>
        </section>

        <section class="flex flex-wrap gap-3 pt-4 border-t border-gold/40">
          <a href={item.url_original} target="_blank" rel="noopener"
             class="px-4 py-2 bg-venetian text-parchment rounded-sm font-sans font-medium hover:bg-venetian/90 transition">
            Otvori original na {sourceLabel} ↗
          </a>
          {item.url_iiif && (
            <a href={item.url_iiif} target="_blank" rel="noopener"
               class="px-4 py-2 border border-gold/40 bg-white/40 rounded-sm font-sans hover:bg-white/80 transition">
              IIIF manifest JSON
            </a>
          )}
          <a href="javascript:history.back()"
             class="px-4 py-2 border border-gold/40 bg-white/40 rounded-sm font-sans hover:bg-white/80 transition">
            ← Nazad
          </a>
          <button type="button" class="hide-btn hidden ml-auto px-4 py-2 text-ink/60 hover:text-venetian text-sm font-sans" data-id={item.id}>
            🗑 Sakrij ovaj rezultat
          </button>
        </section>
      </div>

      <aside class="space-y-6 font-sans text-sm">
        <div class="p-4 bg-white/40 border border-gold/40 rounded-sm">
          <h3 class="text-xs uppercase tracking-wider text-ink/60 mb-3">Detalji</h3>
          <dl class="space-y-2">
            <div>
              <dt class="text-ink/60 text-xs">Izvor</dt>
              <dd>{sourceLabel}</dd>
            </div>
            {dateLabel && (
              <div>
                <dt class="text-ink/60 text-xs">Datum</dt>
                <dd>{dateLabel}</dd>
              </div>
            )}
            {item.author && (
              <div>
                <dt class="text-ink/60 text-xs">Autor</dt>
                <dd>{item.author}</dd>
              </div>
            )}
            {locationLabel && (
              <div>
                <dt class="text-ink/60 text-xs">Lokacija</dt>
                <dd><a href={`/?location=${item.location}`} class="text-venetian hover:underline">{locationLabel}</a></dd>
              </div>
            )}
            {item.language && (
              <div>
                <dt class="text-ink/60 text-xs">Jezik</dt>
                <dd>{item.language}</dd>
              </div>
            )}
            {item.doc_type && (
              <div>
                <dt class="text-ink/60 text-xs">Tip dokumenta</dt>
                <dd>{item.doc_type}</dd>
              </div>
            )}
            {item.tags && item.tags.length > 0 && (
              <div>
                <dt class="text-ink/60 text-xs">Tagovi</dt>
                <dd class="flex flex-wrap gap-1 mt-1">
                  {item.tags.map((t) => (
                    <a href={`/?location=${t}`} class="px-2 py-0.5 bg-ink/10 rounded text-xs hover:bg-venetian/10 hover:text-venetian">{t}</a>
                  ))}
                </dd>
              </div>
            )}
            <div>
              <dt class="text-ink/60 text-xs">ID</dt>
              <dd class="text-xs font-mono break-all">{item.source_id || item.id}</dd>
            </div>
          </dl>
        </div>

        {related.length > 0 && (
          <div class="p-4 bg-white/40 border border-gold/40 rounded-sm">
            <h3 class="text-xs uppercase tracking-wider text-ink/60 mb-3">
              Slični rezultati ({related.length})
            </h3>
            <ul class="space-y-3">
              {related.map((r) => (
                <li>
                  <a href={`/item/${r.id}${q ? `?q=${encodeURIComponent(q)}` : ''}`}
                     class="block hover:text-venetian">
                    <strong class="text-sm leading-tight block">{r.title.slice(0, 100)}</strong>
                    <span class="text-xs text-ink/60">
                      {SOURCE_LABELS[r.source] ?? r.source}
                      {r.date_text && ` · ${r.date_text}`}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </aside>
    </div>
  </article>

  <script is:inline define:vars={{ citeBibtex, citeApa, citeChicago }}>
    document.addEventListener('DOMContentLoaded', () => {
      // --- citation buttons ---
      const FORMATS = { bibtex: citeBibtex, apa: citeApa, chicago: citeChicago };
      const citeOutput = document.getElementById('cite-output');
      const citePre = document.getElementById('cite-pre');
      const citeCopyBtn = document.getElementById('cite-copy-btn');
      let activeFmt = null;

      document.querySelectorAll('.cite-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const fmt = btn.dataset.fmt;
          if (activeFmt === fmt) {
            citeOutput.classList.add('hidden');
            activeFmt = null;
            document.querySelectorAll('.cite-btn').forEach(b => b.classList.remove('bg-venetian', 'text-parchment', 'border-venetian'));
          } else {
            activeFmt = fmt;
            citePre.textContent = FORMATS[fmt] ?? '';
            citeOutput.classList.remove('hidden');
            document.querySelectorAll('.cite-btn').forEach(b => {
              const active = b.dataset.fmt === fmt;
              b.classList.toggle('bg-venetian', active);
              b.classList.toggle('text-parchment', active);
              b.classList.toggle('border-venetian', active);
            });
          }
        });
      });

      if (citeCopyBtn) {
        citeCopyBtn.addEventListener('click', () => {
          if (!activeFmt) return;
          navigator.clipboard.writeText(FORMATS[activeFmt] ?? '').then(() => {
            const orig = citeCopyBtn.textContent;
            citeCopyBtn.textContent = '✓ Kopirano!';
            setTimeout(() => { citeCopyBtn.textContent = orig; }, 1800);
          });
        });
      }

      // --- translate section ---
      const transcriptEl = document.getElementById('transcript');
      if (!transcriptEl) return;
      const itemId = transcriptEl.dataset.itemId;
      const status = document.getElementById('translate-status');
      const translateBtn = document.getElementById('translate-cg-btn');
      const toggleBtn = document.getElementById('toggle-cg-btn');
      const cgEl = document.getElementById('transcript-cg');
      const origEl = document.getElementById('transcript-original');

      function showStatus(msg, isErr) {
        if (!status) return;
        status.classList.remove('hidden');
        status.textContent = msg;
        status.classList.toggle('bg-venetian/10', isErr);
        status.classList.toggle('text-venetian', isErr);
        status.classList.toggle('bg-gold/10', !isErr);
      }

      if (translateBtn) {
        translateBtn.addEventListener('click', async () => {
          translateBtn.disabled = true;
          translateBtn.textContent = '⏳ Prevodi...';
          showStatus('Šaljem tekst Claude AI servisu — prvi put traje ~10-30s. Sledeći put će biti instant (kešira se).', false);
          try {
            const r = await fetch('/api/translate-cg', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ id: itemId }),
            });
            const data = await r.json();
            if (!r.ok) throw new Error(data.error || `HTTP ${r.status}`);
            showStatus(`✓ Prevod gotov (${data.input_chars} → ${data.output_chars} karaktera). Refresh-ujem stranu...`, false);
            setTimeout(() => location.reload(), 1500);
          } catch (e) {
            showStatus('Greška: ' + e.message, true);
            translateBtn.disabled = false;
            translateBtn.textContent = '📜 Prevedi na CG';
          }
        });
      }

      if (toggleBtn && cgEl && origEl) {
        toggleBtn.addEventListener('click', () => {
          const showingCg = !cgEl.classList.contains('hidden');
          if (showingCg) {
            cgEl.classList.add('hidden');
            toggleBtn.textContent = '🇲🇪 Prikaži CG prevod';
          } else {
            cgEl.classList.remove('hidden');
            toggleBtn.textContent = '🔤 Prikaži original';
          }
        });
      }
    });
  </script>
</Layout>
