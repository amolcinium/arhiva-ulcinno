---
interface Props {
  title?: string;
  description?: string;
}
const { title = 'Arhiva Ulcinj', description = 'Federalna pretraga starih arhiva o Ulcinju i okolini — Vatikan, Mletačka, rimski natpisi, italijanski drzavni arhivi.' } = Astro.props;
---
<!DOCTYPE html>
<html lang="sr-Latn">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={`https://arhiva.ulcinno.com${Astro.url.pathname}`} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,600;1,400&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
</head>
<body class="min-h-screen bg-parchment text-ink font-serif dark:bg-ink dark:text-parchment">
  <header class="border-b-2 border-gold/40 bg-parchment/80 backdrop-blur sticky top-0 z-10">
    <div class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between">
      <a href="/" class="flex items-center gap-2 hover:opacity-80">
        <span class="text-2xl">📜</span>
        <span class="text-xl font-semibold">Arhiva Ulcinj</span>
      </a>
      <nav class="flex gap-4 text-sm font-sans items-center flex-wrap">
        <a href="/" class="hover:text-venetian">Pretraga</a>
        <a href="/zbirke" class="hover:text-venetian">Zbirke</a>
        <a href="/mapa" class="hover:text-venetian">Mapa</a>
        <a href="/vremenska-osa" class="hover:text-venetian hidden md:inline">Vremenska osa</a>
        <a href="/stats" class="hover:text-venetian hidden md:inline">Statistika</a>
        <a href="/uporedi" class="hover:text-venetian">Uporedi</a>
        <a href="/o-projektu" class="hover:text-venetian hidden md:inline">O projektu</a>
        <button id="theme-toggle" type="button" class="hover:text-venetian text-base" title="Light/dark mode">🌓</button>
      </nav>
    </div>
  </header>
  <main>
    <slot />
  </main>
  <footer class="mt-16 border-t border-gold/40 py-8 text-center text-sm font-sans text-ink/60">
    <p>Arhiva Ulcinj · Otvoreni istraživački portal · <a href="https://ulcinno.com" class="hover:text-venetian">Ulcinno</a> · {new Date().getFullYear()}</p>
    <p class="mt-2">Izvori: Europeana, Internet Archive, EDH, DigiVatLib, Antenati. Sav sadržaj zadržava prava izvornih institucija.</p>
  </footer>
</body>
</html>

<style is:global>
  :root { color-scheme: light; }
  body { font-feature-settings: 'kern','liga','calt'; }
</style>

<script is:inline>
  // Theme toggle (light/dark) — stored in localStorage 'arhiva_theme'
  (function() {
    const KEY = 'arhiva_theme';
    const saved = localStorage.getItem(KEY);
    if (saved === 'dark') document.documentElement.classList.add('dark');
    document.addEventListener('DOMContentLoaded', () => {
      const btn = document.getElementById('theme-toggle');
      if (btn) btn.addEventListener('click', () => {
        const nowDark = !document.documentElement.classList.contains('dark');
        document.documentElement.classList.toggle('dark', nowDark);
        localStorage.setItem(KEY, nowDark ? 'dark' : 'light');
      });
    });
  })();

  // Search history: track all submitted queries in localStorage
  (function() {
    const KEY = 'arhiva_search_history';
    const params = new URLSearchParams(window.location.search);
    const q = params.get('q');
    if (q && q.trim().length > 1) {
      try {
        const hist = JSON.parse(localStorage.getItem(KEY) || '[]');
        const now = new Date().toISOString();
        // Dedupe and keep last 20
        const filtered = hist.filter(h => h.q !== q).slice(0, 19);
        filtered.unshift({ q, t: now });
        localStorage.setItem(KEY, JSON.stringify(filtered));
      } catch (e) {}
    }
    // On home page, render history below quick links
    if (window.location.pathname === '/' && !q && !params.get('location') && !params.get('source')) {
      document.addEventListener('DOMContentLoaded', () => {
        try {
          const hist = JSON.parse(localStorage.getItem(KEY) || '[]');
          if (!hist.length) return;
          const container = document.querySelector('section.border-b');
          if (!container) return;
          const histEl = document.createElement('div');
          histEl.className = 'mt-4 text-xs font-sans text-ink/60';
          histEl.innerHTML = '<span class="mr-2">🕒 Skoro pretraženo:</span>' +
            hist.slice(0, 8).map(h => `<a href="/?q=${encodeURIComponent(h.q)}" class="mr-2 underline hover:text-venetian">${h.q.length > 30 ? h.q.slice(0, 30) + '…' : h.q}</a>`).join('');
          const inner = container.querySelector('.max-w-4xl');
          if (inner) inner.appendChild(histEl);
        } catch (e) {}
      });
    }
  })();

  // Compare basket: track selected results in localStorage
  (function() {
    window.arhivaCompare = {
      KEY: 'arhiva_compare_basket',
      get() { try { return JSON.parse(localStorage.getItem(this.KEY) || '[]'); } catch { return []; } },
      add(id, title) {
        const cur = this.get();
        if (cur.some(x => x.id === id)) return false;
        if (cur.length >= 4) return false;
        cur.push({ id, title });
        localStorage.setItem(this.KEY, JSON.stringify(cur));
        this.updateBadge();
        return true;
      },
      remove(id) {
        const cur = this.get().filter(x => x.id !== id);
        localStorage.setItem(this.KEY, JSON.stringify(cur));
        this.updateBadge();
      },
      clear() { localStorage.removeItem(this.KEY); this.updateBadge(); },
      updateBadge() {
        const n = this.get().length;
        document.querySelectorAll('a[href="/uporedi"]').forEach(a => {
          a.textContent = n > 0 ? `Uporedi (${n})` : 'Uporedi';
        });
      },
    };
    document.addEventListener('DOMContentLoaded', () => window.arhivaCompare.updateBadge());
  })();

  // Admin mode: ?admin=<token> in URL stores token in localStorage and shows hide buttons.
  // Logout: ?admin=logout
  (function() {
    const params = new URLSearchParams(window.location.search);
    const adminParam = params.get('admin');
    const KEY = 'arhiva_admin_token';
    if (adminParam === 'logout') {
      localStorage.removeItem(KEY);
      params.delete('admin');
      const newUrl = window.location.pathname + (params.toString() ? '?' + params.toString() : '');
      window.location.replace(newUrl);
      return;
    }
    if (adminParam) {
      localStorage.setItem(KEY, adminParam);
      params.delete('admin');
      const newUrl = window.location.pathname + (params.toString() ? '?' + params.toString() : '');
      window.history.replaceState({}, '', newUrl);
    }
    const token = localStorage.getItem(KEY);
    if (!token) return;
    // Admin mode active — reveal hide buttons + add visual indicator
    document.documentElement.classList.add('admin-mode');
    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('.hide-btn').forEach((btn) => {
        btn.classList.remove('hidden');
        btn.addEventListener('click', async (e) => {
          e.stopPropagation();
          e.preventDefault();
          const id = btn.dataset.id;
          if (!id || !confirm('Sakriti ovaj rezultat? (Možeš ga vratiti na /admin/sakriveni stranici)')) return;
          btn.disabled = true;
          btn.textContent = '...';
          try {
            const r = await fetch('/api/hide', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ id, token, hide: true }),
            });
            if (!r.ok) throw new Error(`HTTP ${r.status}`);
            // Hide the card visually
            const card = btn.closest('article');
            if (card) {
              card.style.opacity = '0.3';
              card.style.pointerEvents = 'none';
              btn.textContent = '✓ sakriveno';
            }
          } catch (err) {
            alert('Greška: ' + err.message);
            btn.disabled = false;
            btn.textContent = '🗑 Sakrij';
          }
        });
      });
      // Add admin badge to header
      const header = document.querySelector('header nav');
      if (header && !header.querySelector('.admin-badge')) {
        const badge = document.createElement('a');
        badge.className = 'admin-badge text-venetian text-xs font-semibold';
        badge.href = '?admin=logout';
        badge.title = 'Admin mode active. Click to logout.';
        badge.textContent = '👤 admin';
        header.appendChild(badge);
      }
    });
  })();
</script>
