{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arhiva-ulcinno",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
